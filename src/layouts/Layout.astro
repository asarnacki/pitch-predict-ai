---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.vue";
import UserNav from "../components/UserNav.vue";
import LanguageSwitcher from "../components/LanguageSwitcher.vue";

interface Props {
  title?: string;
}

const { title = "PitchPredict AI" } = Astro.props;

// Get user from middleware (set by src/middleware/index.ts)
const user = Astro.locals.user ?? null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("dark");
    </script>
  </head>
  <body>
    <header class="bg-background/80 fixed top-0 right-0 left-0 z-50 border-b backdrop-blur-md">
      <div class="container mx-auto flex items-center justify-between px-4 py-3">
        <a href="/" class="text-xl font-bold tracking-tight sm:text-2xl" data-testid="nav-logo"> PitchPredict AI </a>
        <div class="flex items-center gap-3 sm:gap-4">
          <UserNav client:load user={user} />
          <LanguageSwitcher client:load />
          <ThemeToggle client:load />
        </div>
      </div>
    </header>
    <div class="pt-16">
      <slot />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
