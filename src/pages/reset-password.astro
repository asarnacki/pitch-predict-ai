---
import Layout from "../layouts/Layout.astro";
import AuthForm from "../components/AuthForm.vue";
import { Toaster } from "../components/ui/sonner";

// This page should be server-side rendered
export const prerender = false;

// Middleware automatically redirects logged-in users to home (see src/middleware/index.ts)
// No additional redirect logic needed here
---

<Layout title="Resetuj hasło - PitchPredict AI">
  <main class="bg-background flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-md">
      <AuthForm client:load mode="reset-password" />
    </div>
  </main>
  <Toaster client:load />
</Layout>
